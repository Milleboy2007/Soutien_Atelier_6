      "name": "Préparer le billet (IA)"
    },
    {
      "parameters": {
        "jsCode": "const demande = $('Demande recue').first().json.body.message; \n\nconst service = $('Vérifier le service').first().json.statusCode; \n\nconst texteIA = $input.first().json.response; \n\n \n\nconst markdown = `\n# Billet automatique\n\n- Reçu : ${new Date().toISOString()}\n\n- Message : ${demande}\n\n- État du service : ${service}\n\n \n\n${texteIA}`; \n\n \n\nreturn { markdown }; "
      },
      "type": "n8n-nodes-base.code",
