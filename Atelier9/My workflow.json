              "value": "={{ \"Tu es un agent de soutien technique de RapidoBouffe.\\n\" \n\n+ \"Réponds uniquement en Markdown, sans bloc de code.\\n\\n\" \n\n+ \"Message de l'usager :\\n\" + $('Demande recue').item.json.body.message + \"\\n\\n\" \n\n+ \"État du service : code HTTP \" + $json.statusCode + \"\\n\\n\" \n\n+ \"Rédige un billet avec exactement ces sections :\\n\" \n\n+ \"# Résumé\\n# Catégorie\\n# Priorité\\n# Questions à poser\\n# Hypothèse\\n\" }} "
